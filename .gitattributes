# Check every text file out with LF on every platform.
#
# 44 unit test files read repository source with readFileSync and match it
# against multi-line regexes (src/scenes/director.test.mjs,
# src/cockpitMarkup.test.mjs, src/firstRunExperience.test.mjs, ...). Those
# patterns anchor on \n, so under Git's default core.autocrlf=true on Windows
# the sources check out with CRLF, every anchored pattern misses, and `npm test`
# fails 25 checks on an unmodified clone. Normalizing here keeps the working
# tree byte-identical on macOS, Linux, and Windows.
* text=auto eol=lf

# Shell launchers must stay LF to run at all.
*.sh text eol=lf

# Assets Git must never rewrite.
*.gif binary
*.png binary
*.glb binary
*.wav binary
*.pbf binary
# Gzipped storm payloads, and the fine 1 km per-day family of ~1,000 of them.
# Without this line they fall through to `* text=auto` and are only safe by
# Git's content sniff. That heuristic holds today, but it is implicit: a file
# whose first 8,000 bytes happen to look like text would be rewritten to LF and
# corrupted, and there is no test that would catch it. Declare it instead.
*.gz binary

# Generated, and mechanically so: `npm run build:storm-radar` writes all of
# these. They are committed because the app must ship them and CI cannot build
# them, but `linguist-generated` is what stops GitHub from rendering 1,019
# binary blobs in every diff and counting them as hand-written code.
src/data/local_data/storm/*.gz linguist-generated=true
src/data/local_data/storm/*.geojsonl linguist-generated=true
src/data/local_data/storm/storm-*-sources*.json linguist-generated=true
src/data/local_data/housing_units/*.gz linguist-generated=true
src/data/local_data/housing_units/*.json linguist-generated=true
